// Written by coprocessor/image/provision.sh: soft-off, the health agent's one power. The agent's
// account may stop PhotonVision and power the board off; polkit refuses it everything else.
// (Its POST /v1/shutdown takes requests from the robot controller only.)
(function () {
  var agentUser = "@AGENT_USER@";

  polkit.addRule(function (action, subject) {
    if (subject.user !== agentUser) {
      return polkit.Result.NOT_HANDLED;
    }
    if (action.id === "org.freedesktop.login1.power-off") {
      return polkit.Result.YES;
    }
    if (action.id === "org.freedesktop.systemd1.manage-units" &&
        action.lookup("unit") === "photonvision.service" &&
        action.lookup("verb") === "stop") {
      return polkit.Result.YES;
    }
    return polkit.Result.NO;
  });
})();
